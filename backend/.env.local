# Copy to .env and adjust as needed.
# Port the API listens on. The Vite dev proxies in ../frontend and ../dashboard
# forward /api here, so if you change this port, update vite.config.js there too.
DATABASE_URL=postgresql://user:pass@host:5432/db
PORT=5001
HOST=0.0.0.0

# Secret used to sign admin JWT tokens (change in production!).
JWT_SECRET=swiftship-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Where the JSON database file lives (created automatically).
DB_FILE=

SEED_ON_START=true

# --- Email delivery (password reset etc.) ---
# Hostinger SMTP — primary transport (validated: auth OK).
SENDINBLUE_API_KEY=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
EMAIL_FROM="LADSU <sales@ladwongsu.com>"
NEWSLETTER_FROM_EMAIL="LADSU <sales@ladwongsu.com>"
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=sales@ladwongsu.com
EMAIL_HOST_PASSWORD=[ExvRW]zA6
GOOGLE_EMAIL_USER=sales@ladwongsu.com
GOOGLE_EMAIL_APP_PASSWORD=[ExvRW]zA6

# Google OAuth (used by Better Auth on the Convex backend as
