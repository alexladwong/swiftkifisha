{
  "name": "SwiftPak-convex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Convex backend (project precise-pig-300) for SwiftPak Global shop-and-ship, with Better Auth on Convex.",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
