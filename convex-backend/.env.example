# Copy to .env.local after running `npx convex dev` (the CLI creates one) or
# set each value with:  npx convex env set KEY value
# NOTE: this template contains live credentials (see the project owner's
# setup). Do NOT push this repository to a public remote with secrets intact.

# Better Auth encryption/signing secret (required). Generate one with:
#   npx convex env set BETTER_AUTH_SECRET $(openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public origin of the auth instance (dashboard/admin app in dev).
SITE_URL=http://localhost:5174

# Public origin of the customer-facing site. Used as the base for
# password-reset links when the request carries no Origin header. In dev the
# HTTP layer forwards the caller's Origin, so the reset link always points at
# the app that requested it (http://localhost:5173 or :5174).
# FRONTEND_URL=http://localhost:5173

# Password-reset demo mode (no SMTP provider configured yet):
# - Non-production NODE_ENV (default): the reset link is logged AND returned
#   in the response as `devResetLink`, so the flow works without an inbox.
# - Production: set RESET_LINK_DEBUG=true only if you want the same behaviour
#   until an email provider (SMTP/Resend) replaces the console fallback.
# NODE_ENV=development
# RESET_LINK_DEBUG=true

# --- Social sign-in (Google via Better Auth) ---
# Register a Google OAuth app and set both values to enable the button:
#   https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://precise-pig-300.convex.site/api/auth/callback/google
BETTER_AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
BETTER_AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- Transactional email (password-reset delivery) ---
# Brevo (Sendinblue) API key; reset emails are sent from EMAIL_FROM when set.
# NOTE: this key currently returns 401 — replace with a valid key or reset
# emails fall back to logs/devResetLink. (The Express backend uses the
# Hostinger SMTP credentials from backend/.env instead.)
SENDINBLUE_API_KEY=replace-with-your-brevo-api-key
EMAIL_FROM="LADSU <sales@ladwongsu.com>"
NEWSLETTER_FROM_EMAIL="LADSU <sales@ladwongsu.com>"

# Set by Convex automatically during dev/deploy; used for native auth JWKS and
# as the base for OAuth redirect/callback URLs.
# CONVEX_SITE_URL=https://precise-pig-300.convex.site
