# Copy to .env.local after running `npx convex dev` (the CLI creates one) or
# set each value with:  npx convex env set KEY value

# Better Auth encryption/signing secret (required). Generate one with:
#   npx convex env set BETTER_AUTH_SECRET $(openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public origin of the auth instance (dashboard/admin app in dev).
SITE_URL=http://localhost:5174

# Set by Convex automatically during dev/deploy; used for native auth JWKS.
# CONVEX_SITE_URL=https://precise-pig-300.convex.site