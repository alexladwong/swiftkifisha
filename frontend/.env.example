# Copy to .env.local as needed.

# Local Express API (default): leave unset (axios falls back to /api, proxied by Vite to the backend).
# Convex deployment: point at the HTTP actions site.
# VITE_API_BASE_URL=https://precise-pig-300.convex.site/api

# Vite dev proxy target for /api (overrides the localhost:5001 default).
# API_PROXY=https://precise-pig-300.convex.site